{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dart-project/schemas/case_pack_schema_v0.json",
  "title": "Demo Case Pack v0",
  "description": "금융 탐정게임 데모용 Case Pack. 모든 문서/숫자/문장은 실제 DART 공시 DocumentIR에서 파생되며, simulation_date 이후 문서는 future_events에만 등장한다.",
  "type": "object",
  "required": [
    "case_id", "company", "case_title", "simulation_date", "mission", "intro",
    "available_documents", "evidence", "finance_terms", "decision_options",
    "future_events", "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "generator": { "type": "object" },
    "case_id": { "type": "string", "pattern": "^CASE-[0-9]{3}$" },
    "company": {
      "type": "object",
      "required": ["corp_name", "listed_name", "corp_code", "stock_code", "industry", "sector"],
      "properties": {
        "corp_name": { "type": "string" },
        "listed_name": { "type": "string" },
        "corp_code": { "type": "string", "pattern": "^[0-9]{8}$" },
        "stock_code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "industry": { "type": "string" },
        "sector": { "type": "string" }
      }
    },
    "case_title": { "type": "string" },
    "simulation_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "mission": { "type": "string" },
    "intro": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"] },

    "available_documents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["document_id", "doc_id", "title", "document_date", "source_type", "original_text", "display_excerpt"],
        "additionalProperties": false,
        "properties": {
          "document_id": { "type": "string", "pattern": "^D[0-9]{2}$" },
          "doc_id": { "type": "string", "description": "DocumentIR / manifest의 원본 doc_id" },
          "rcept_no": { "type": "string" },
          "title": { "type": "string" },
          "document_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "source_type": {
            "type": "string",
            "enum": ["exchange", "periodic", "major", "holding"]
          },
          "doc_subtype": { "type": ["string", "null"] },
          "report_nm": { "type": "string" },
          "is_correction": { "type": "boolean" },
          "role": {
            "type": "string",
            "enum": ["trigger", "financials", "business", "context", "risk"]
          },
          "original_text": { "type": "string", "description": "DocumentIR에서 재구성한 원문 텍스트(표는 행 단위 직렬화)" },
          "display_excerpt": { "type": "string", "description": "original_text의 부분 문자열이어야 한다" },
          "source_locator": { "type": "object" }
        }
      }
    },

    "evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["evidence_id", "document_id", "text", "source_text", "category", "importance", "educational_reason"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
          "document_id": { "type": "string", "pattern": "^D[0-9]{2}$" },
          "text": { "type": "string", "description": "플레이어에게 보여줄 한 줄 요약(숫자는 원문과 일치해야 함)" },
          "source_text": { "type": "string", "description": "DocumentIR 원문 그대로" },
          "category": {
            "type": "string",
            "enum": ["finance", "business", "risk", "investment", "timeline"]
          },
          "importance": { "type": "string", "enum": ["critical", "optional"] },
          "educational_reason": { "type": "string" },
          "source_locator": { "type": "object" }
        }
      }
    },

    "finance_terms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["term", "short_definition", "why_it_matters_here", "source_evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "short_definition": { "type": "string" },
          "why_it_matters_here": { "type": "string" },
          "source_evidence_ids": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^E[0-9]{2}$" }
          }
        }
      }
    },

    "decision_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["option_id", "label", "description", "supporting_evidence_ids", "counter_evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "option_id": { "type": "string", "pattern": "^O[0-9]$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "counter_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "feedback_if_missing_critical": { "type": "string" }
        }
      }
    },

    "future_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "event", "source_document_id"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "event": { "type": "string" },
          "source_document_id": { "type": "string", "description": "DocumentIR doc_id" },
          "report_nm": { "type": "string" },
          "source_text": { "type": "string" },
          "changed_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "before", "after"],
              "properties": {
                "field": { "type": "string" },
                "before": { "type": "string" },
                "after": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "validation": {
      "type": "object",
      "required": ["future_leakage", "all_evidence_grounded"],
      "properties": {
        "future_leakage": { "type": "boolean", "const": false },
        "all_evidence_grounded": { "type": "boolean", "const": true },
        "checked_at": { "type": "string" },
        "checks": { "type": "object" }
      }
    }
  }
}
